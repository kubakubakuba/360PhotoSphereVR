# Copy to .env and adjust. All values are optional.

# --- Server ---------------------------------------------------------------
# Host ports
HTTPS_PORT=8360
HTTP_PORT=8361
# Hostname used for nginx and the self-signed certificate
SERVER_NAME=localhost
# Extra certificate SANs, e.g. your LAN IP so the headset can connect
# SSL_SAN=IP:192.168.1.50,DNS:pano.local
SSL_SAN=

# --- Content (host paths) -------------------------------------------------
IMAGES_DIR=./imgs
THUMBS_DIR=./thumb
GALLERY_FILE=./gallery.json
CERTS_DIR=./certs

# --- App ------------------------------------------------------------------
APP_TITLE=360° Photo Sphere
# Panorama shown first; empty = gallery entry with "default": true, else the first entry
DEFAULT_PANORAMA=
GALLERY_URL=gallery.json

# --- VR -------------------------------------------------------------------
# Show passthrough behind the gallery / transitions (immersive-ar) when supported
VR_PASSTHROUGH=true
# Display photos through a WebXR equirect compositor layer (sharpest); false = sphere mesh
VR_USE_LAYERS=true
# Fixed foveation 0..1 (0 = full resolution everywhere)
VR_FOVEATION=0
# Eye buffer scale; 0 = device native (capped at 1.5)
VR_FRAMEBUFFER_SCALE=0
# Max panorama size in VR (px); 0 = 8192, about the Quest 3 display resolution
VR_MAX_TEXTURE_SIZE=0
